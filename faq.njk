---
layout: base.njk
title: Частые вопросы
description: Ответы на частые вопросы о детейлинге автомобиля — запись, гарантия, сроки, материалы и стоимость работ.
permalink: /faq/
---

<!-- PAGE HERO -->
<section class="page-hero page-hero--short">
  <div class="page-hero__overlay"></div>
  <div class="page-hero__content">
    <nav class="breadcrumb" aria-label="Хлебные крошки">
      <a href="/">Главная</a>
      <span>—</span>
      <span>FAQ</span>
    </nav>
    <h1>Частые вопросы</h1>
    <p>Собрали ответы на самые популярные вопросы клиентов</p>
  </div>
</section>

<!-- FAQ -->
<section class="faq-section faq-section--page">
  <div class="faq-section__inner">
    <div class="faq-page__layout">

      <div class="faq-page__aside">
        <p class="faq-page__count">{{ faq | length }} вопросов</p>
        <p class="faq-page__hint">Не нашли ответ? Свяжитесь с нами — ответим в течение нескольких минут.</p>
        <div class="faq-page__contacts">
          <a href="{{ site.phoneHref }}" class="faq-page__link">{{ site.phone }}</a>
          <a href="{{ site.telegram }}" class="faq-page__link" target="_blank" rel="noopener">Написать в Telegram →</a>
        </div>
      </div>

      <div class="faq-list" role="list">
        {% for item in faq %}
        <div class="faq-item" role="listitem">
          <button
            class="faq-item__btn"
            aria-expanded="false"
            aria-controls="faq-answer-{{ loop.index }}"
          >
            <span class="faq-item__num">{% if loop.index < 10 %}0{{ loop.index }}{% else %}{{ loop.index }}{% endif %}</span>
            <span class="faq-item__q">{{ item.q }}</span>
            <span class="faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-item__answer" id="faq-answer-{{ loop.index }}" role="region">
            <p>{{ item.a }}</p>
          </div>
        </div>
        {% endfor %}
      </div>

    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-form">
  <div class="cta-form__inner">
    <div class="cta-form__text">
      <h2>Остались<br>вопросы?</h2>
      <p>Оставьте заявку — наш специалист свяжется с вами, ответит на все вопросы и запишет на удобное время.</p>
    </div>
    <form class="cta-form__form" id="cta-form-faq" novalidate>
      <input type="text" name="name" placeholder="Ваше имя" required>
      <input type="tel" name="phone" placeholder="Телефон" required>
      <label class="cta-form__checkbox">
        <input type="checkbox" name="agree" required>
        <span>Нажимая кнопку, вы соглашаетесь с политикой обработки персональных данных</span>
      </label>
      <button type="submit" class="btn btn--outline">Оставить заявку →</button>
    </form>
  </div>
</section>
