---
layout: base.njk
pagination:
  data: subservices_list
  size: 1
  alias: sub
permalink: /{{ sub.slug }}/
bodyClass: page-subservice
---

<!-- HERO -->
<section class="page-hero page-hero--full" style="background-image: url('{{ sub.img }}')">
  <div class="page-hero__overlay"></div>
  <div class="page-hero__content">
    <div class="breadcrumb">
      <a href="/">Главная</a>
      <span>/</span>
      <span>{{ sub.title }}</span>
    </div>
    <h1>{{ sub.title }}</h1>
    <p>{{ sub.desc }}</p>
    <a href="#price" class="btn btn--outline">Смотреть цены →</a>
  </div>
</section>

<!-- PRICE TABLE -->
<section class="price-section" id="price">
  <div class="price-section__inner">
    <h2 class="section-title">// {{ sub.tableTitle }}</h2>
    <p class="price-note">Конкретные цены зависят от автомобиля. Точную стоимость уточняйте у менеджера.</p>

    <div class="price-table">
      {% for row in sub.rows %}
      <div class="price-row">
        <span class="price-row__name">{{ row.name }}</span>
        <span class="price-row__dots"></span>
        <span class="price-row__price">{{ row.price }}</span>
      </div>
      {% endfor %}
    </div>

    <div class="price-cta">
      <button class="btn btn--outline js-open-modal">Записаться на услугу →</button>
    </div>
  </div>
</section>

<!-- DESCRIPTION -->
{% if sub.descBlocks %}
<section class="service-desc">
  <div class="service-desc__inner">
    {% for block in sub.descBlocks %}
    <div class="service-desc__block">
      <h2>{{ block.h2 }}</h2>
      <p>{{ block.text }}</p>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

<!-- CONTACT FORM -->
<section class="cta-form contacts-cta" id="contact-form">
  <div class="cta-form__bg" style="background-image: url('{{ site.ctaBg }}')"></div>
  <div class="contacts-cta__inner">
    <h2>Рассчитать стоимость</h2>
    <p>Оставьте свой номер телефона и наш менеджер свяжется с вами в ближайшее время</p>
    <form class="cta-form__form" data-service="{{ sub.title }}">
      <input type="hidden" name="service" value="{{ sub.title }}">
      <input type="text" name="name" placeholder="Ваше имя" required>
      <input type="tel" name="phone" placeholder="Номер телефона" required>
      <label class="cta-form__checkbox">
        <input type="checkbox" required>
        <span>Нажимая кнопку, вы даёте согласие на обработку персональных данных</span>
      </label>
      <button type="submit" class="btn btn--outline">Получить консультацию</button>
    </form>
  </div>
</section>

<!-- REVIEWS -->
<section class="reviews">
  <div class="reviews__header">
    <h2 class="section-title">// Отзывы</h2>
    <p>Отзывы помогают нашей команде становиться лучше</p>
  </div>
  <div class="reviews__track-wrap">
    <div class="reviews__track" id="reviewsTrack">
      {% for review in pagedata.reviews %}
      <div class="review-card">
        <div class="review-card__top">
          <div class="review-card__avatar">{{ review.avatar }}</div>
          <div>
            <div class="review-card__name">{{ review.name }}</div>
            <div class="review-card__stars">{% for i in range(0, review.rating) %}★{% endfor %}</div>
          </div>
          <div class="review-card__source">
            {% if review.source === "yandex" %}
            <svg width="20" height="20" viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#FC3F1D"/><text x="6" y="17" font-size="14" fill="white" font-family="Arial" font-weight="bold">Я</text></svg>
            {% else %}
            <svg width="20" height="20" viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#00B956"/><text x="5" y="17" font-size="11" fill="white" font-family="Arial" font-weight="bold">2Гис</text></svg>
            {% endif %}
          </div>
        </div>
        <p class="review-card__text">{{ review.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
  <div class="reviews__controls">
    <button class="reviews__btn" id="reviewsPrev" aria-label="Назад">←</button>
    <button class="reviews__btn" id="reviewsNext" aria-label="Вперёд">→</button>
  </div>
</section>

<!-- FAQ -->
{% if sub.faq %}
<section class="faq-section">
  <div class="faq-section__inner">
    <h2 class="section-title">// Ответы на вопросы</h2>
    <div class="faq-list">
      {% for item in sub.faq %}
      <div class="faq-item">
        <button class="faq-item__btn" aria-expanded="false">
          <span class="faq-item__num">0{{ loop.index }}</span>
          <span class="faq-item__q">{{ item.q }}</span>
          <span class="faq-item__icon">+</span>
        </button>
        <div class="faq-item__answer">
          <p>{{ item.a }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
