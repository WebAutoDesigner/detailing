<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if sub %}{{ sub.title }}{% elif svc %}{{ svc.title }}{% else %}{{ title }}{% endif %} — {{ site.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

{% if not noHeader %}
<!-- HEADER -->
<header class="header" id="header">
  <div class="header__inner">
    <div class="header__left">
      <a href="/" class="header__logo">{{ site.name }}</a>
      <div class="header__socials">
        <a href="{{ site.vk }}" class="header__social" target="_blank" rel="noopener" aria-label="ВКонтакте">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M15.684 0H8.316C1.592 0 0 1.592 0 8.316v7.368C0 22.408 1.592 24 8.316 24h7.368C22.408 24 24 22.408 24 15.684V8.316C24 1.592 22.408 0 15.684 0zm3.692 17.123h-1.744c-.66 0-.864-.525-2.05-1.727-1.033-1.01-1.49-1.135-1.744-1.135-.356 0-.458.102-.458.593v1.575c0 .424-.135.678-1.253.678-1.846 0-3.896-1.118-5.335-3.202C4.624 10.857 4.03 8.57 4.03 8.096c0-.254.102-.491.593-.491h1.744c.44 0 .61.203.78.677.863 2.49 2.303 4.675 2.896 4.675.22 0 .322-.102.322-.66V9.721c-.068-1.186-.695-1.287-.695-1.71 0-.203.17-.407.44-.407h2.744c.373 0 .508.203.508.643v3.473c0 .372.17.508.271.508.22 0 .407-.136.813-.542 1.254-1.406 2.151-3.574 2.151-3.574.119-.254.322-.491.762-.491h1.744c.525 0 .643.27.525.643-.22 1.017-2.354 4.031-2.354 4.031-.186.305-.254.44 0 .78.186.254.796.779 1.203 1.253.745.847 1.32 1.558 1.473 2.05.17.49-.085.745-.576.745z"/></svg>
        </a>
        <a href="{{ site.telegram }}" class="header__social" target="_blank" rel="noopener" aria-label="Telegram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12L7.17 13.67l-2.96-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.194 1.006.131.978.889z"/></svg>
        </a>
      </div>
      <span class="header__city">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
        {{ site.address }}
      </span>
    </div>

    <nav class="header__nav">
      <!-- Услуги -->
      <div class="nav-item nav-item--dropdown" data-dropdown="services">
        <button class="nav-item__btn">Услуги <span class="nav-item__icon">+</span></button>
        <div class="dropdown dropdown--services">
          <div class="dropdown__inner">
            <ul class="dropdown__services-list">
              {% for service in nav.services %}
              <li class="dropdown__service-item" data-service="{{ loop.index0 }}">
                <span class="dropdown__service-name">{{ service.name }}</span>
                <span class="dropdown__arrow">→</span>
              </li>
              {% endfor %}
            </ul>
            <div class="dropdown__subservices">
              {% for service in nav.services %}
              <ul class="dropdown__sub-list" data-sub="{{ loop.index0 }}">
                {% for sub in service.subservices %}
                <li><a href="/{{ sub.slug }}">{{ sub.name }}</a></li>
                {% endfor %}
              </ul>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>

      <!-- О компании -->
      <div class="nav-item nav-item--dropdown" data-dropdown="company">
        <button class="nav-item__btn">О компании <span class="nav-item__icon">+</span></button>
        <div class="dropdown dropdown--company">
          <ul class="dropdown__list">
            {% for item in nav.company %}
            <li><a href="/{{ item.slug }}">{{ item.name }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </nav>

    <div class="header__right">
      <a href="{{ site.phoneHref }}" class="header__phone">{{ site.phone }}</a>
      <button class="header__cta" id="openModal">Связаться с нами →</button>
    </div>

    <button class="burger" id="burger" aria-label="Меню">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
{% endif %}

<!-- MAIN -->
<main>
  {{ content | safe }}
</main>

{% if not noFooter %}
<!-- FOOTER -->
<footer class="footer">
  <div class="footer__inner">
    <div class="footer__col footer__col--brand">
      <a href="/" class="footer__logo">{{ site.name }}</a>
      <p>{{ site.tagline }}</p>
      <div class="footer__socials">
        <a href="{{ site.vk }}" target="_blank" rel="noopener" aria-label="ВКонтакте">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M15.684 0H8.316C1.592 0 0 1.592 0 8.316v7.368C0 22.408 1.592 24 8.316 24h7.368C22.408 24 24 22.408 24 15.684V8.316C24 1.592 22.408 0 15.684 0zm3.692 17.123h-1.744c-.66 0-.864-.525-2.05-1.727-1.033-1.01-1.49-1.135-1.744-1.135-.356 0-.458.102-.458.593v1.575c0 .424-.135.678-1.253.678-1.846 0-3.896-1.118-5.335-3.202C4.624 10.857 4.03 8.57 4.03 8.096c0-.254.102-.491.593-.491h1.744c.44 0 .61.203.78.677.863 2.49 2.303 4.675 2.896 4.675.22 0 .322-.102.322-.66V9.721c-.068-1.186-.695-1.287-.695-1.71 0-.203.17-.407.44-.407h2.744c.373 0 .508.203.508.643v3.473c0 .372.17.508.271.508.22 0 .407-.136.813-.542 1.254-1.406 2.151-3.574 2.151-3.574.119-.254.322-.491.762-.491h1.744c.525 0 .643.27.525.643-.22 1.017-2.354 4.031-2.354 4.031-.186.305-.254.44 0 .78.186.254.796.779 1.203 1.253.745.847 1.32 1.558 1.473 2.05.17.49-.085.745-.576.745z"/></svg>
        </a>
        <a href="{{ site.telegram }}" target="_blank" rel="noopener" aria-label="Telegram">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12L7.17 13.67l-2.96-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.194 1.006.131.978.889z"/></svg>
        </a>
      </div>
    </div>

    <div class="footer__col">
      <h4>О компании</h4>
      <ul>
        {% for item in nav.company %}
        <li><a href="/{{ item.slug }}">{{ item.name }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer__col">
      <h4>Услуги</h4>
      <ul>
        {% for service in nav.services %}
        <li><a href="/{{ service.slug }}">{{ service.name }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer__col footer__col--contacts">
      <h4>Контакты</h4>
      <ul>
        <li><a href="{{ site.phoneHref }}">{{ site.phone }}</a></li>
        <li>{{ site.address }}</li>
        <li>{{ site.workHours }}</li>
      </ul>
    </div>
  </div>
  <div class="footer__bottom">
    <span>© {{ year }} {{ site.name }}. Все права защищены.</span>
  </div>
</footer>
{% endif %}

<!-- MODAL FORM -->
<div class="modal" id="modal" role="dialog" aria-modal="true" aria-label="Заявка">
  <div class="modal__overlay" id="modalOverlay"></div>
  <div class="modal__box">
    <button class="modal__close" id="closeModal" aria-label="Закрыть">×</button>
    <h2 class="modal__title">Заявка на приём<br>автомобиля</h2>
    <p class="modal__sub">Заполните форму — наш менеджер свяжется с вами</p>
    <form class="modal__form" id="modalForm" novalidate>
      <input type="text" name="name" placeholder="Ваше имя" required>
      <input type="tel" name="phone" placeholder="Номер телефона" required>
      <label class="modal__checkbox">
        <input type="checkbox" name="agree" required>
        <span>Нажимая кнопку, вы даёте согласие на обработку персональных данных</span>
      </label>
      <button type="submit" class="modal__submit">Отправить заявку</button>
    </form>
  </div>
</div>

<script src="/script.js"></script>
</body>
</html>
