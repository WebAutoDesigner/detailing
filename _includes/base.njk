          {% elif s.platform === 'whatsapp' %}<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          {% elif s.platform === 'max' %}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="24" height="24" rx="6" fill="url(#max_gf)"/><path d="M12 5.5C8.96 5.5 6.5 7.96 6.5 11c0 1.44.54 2.75 1.43 3.74L7 18l3.5-1.5c.47.14.97.22 1.5.22 3.04 0 5.5-2.46 5.5-5.5S15.04 5.5 12 5.5zm0 2c.83 0 1.5.67 1.5 1.5S12.83 10.5 12 10.5 10.5 9.83 10.5 9 11.17 7.5 12 7.5zm0 7.5c-1.38 0-2.6-.56-3.5-1.46.07-.9.83-1.54 1.75-1.54h3.5c.92 0 1.68.64 1.75 1.54C14.6 14.44 13.38 15 12 15z" fill="white"/><defs><linearGradient id="max_gf" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse"><stop stop-color="#4776E6"/><stop offset="1" stop-color="#8E54E9"/></linearGradient></defs></svg>
          {% else %}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          {% endif %}
        </a>
        {% endfor %}
      </div>
    </div>

    <div class="footer__col">
      <h4>О компании</h4>
      <ul>
        {% for item in nav.company %}
        <li><a href="/{{ item.slug }}">{{ item.name }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer__col">
      <h4>Услуги</h4>
      <ul>
        {% for service in nav.services %}
        <li><a href="/{{ service.slug }}">{{ service.name }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer__col footer__col--contacts">
      <h4>Контакты</h4>
      <ul>
        <li><a href="{{ site.phoneHref }}">{{ site.phone }}</a></li>
        {% if site.email %}<li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>{% endif %}
        <li>{{ site.address }}</li>
        <li>{{ site.workHours }}</li>
        {% if site.workHoursShort %}<li>{{ site.workHoursShort }}</li>{% endif %}
      </ul>
    </div>
  </div>
  <div class="footer__bottom">
    <span>© {{ year }} {{ site.name }}. Все права защищены.</span>
  </div>
</footer>
{% endif %}

<!-- MODAL FORM -->
<div class="modal" id="modal" role="dialog" aria-modal="true" aria-label="Заявка">
  <div class="modal__overlay" id="modalOverlay"></div>
  <div class="modal__box">
    <button class="modal__close" id="closeModal" aria-label="Закрыть">×</button>
    <h2 class="modal__title">Заявка на приём<br>автомобиля</h2>
    <p class="modal__sub">Заполните форму — наш менеджер свяжется с вами</p>
    <form class="modal__form" id="modalForm" novalidate>
      <input type="text" name="name" placeholder="Ваше имя" required>
      <input type="tel" name="phone" placeholder="Номер телефона" required>
      <label class="modal__checkbox">
        <input type="checkbox" name="agree" required>
        <span>Нажимая кнопку, вы даёте согласие на обработку персональных данных</span>
      </label>
      <button type="submit" class="modal__submit">Отправить заявку</button>
    </form>
  </div>
</div>

<script src="/script.js"></script>

<!-- Schema.org LocalBusiness -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  "name": "{{ site.name }}",
  "description": "{{ site.tagline }}",
  "telephone": "{{ site.phone }}",
  "url": "{{ site.siteUrl }}",
  "image": "{{ site.siteUrl }}/images/hero-1.jpg",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.address }}"
  },
  "openingHours": "{{ site.workHours }}"
}
</script>
</body>
</html>
