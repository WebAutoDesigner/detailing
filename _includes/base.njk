<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {% set pageTitle %}{% if sub %}{{ sub.title }}{% elif svc %}{{ svc.title }}{% else %}{{ title }}{% endif %} — {{ site.name }}{% endset %}
  {% set pageDesc %}{% if sub and sub.desc %}{{ sub.desc }}{% elif svc and svc.desc %}{{ svc.desc }}{% elif description %}{{ description }}{% else %}{{ site.tagline }}{% endif %}{% endset %}
  {% set pageUrl %}{{ site.siteUrl }}{{ page.url }}{% endset %}
  {% if sub and sub.img %}
    {% set pageImg %}{{ site.siteUrl }}{{ sub.img }}{% endset %}
  {% elif svc and svc.img %}
    {% set pageImg %}{{ site.siteUrl }}{{ svc.img }}{% endset %}
  {% else %}
    {% set pageImg %}{{ site.siteUrl }}/images/hero-1.jpg{% endset %}
  {% endif %}

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc | truncate(160) }}">
  {% if site.siteUrl %}<link rel="canonical" href="{{ pageUrl }}">{% endif %}

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc | truncate(160) }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ pageImg }}">
  <meta property="og:locale" content="ru_RU">
  <meta property="og:site_name" content="{{ site.name }}">

  <!-- Favicon (заменить файлы когда будет логотип) -->
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="shortcut icon" href="/favicon.ico">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

{% if not noHeader %}
<!-- HEADER -->
<header class="header" id="header">
  <div class="header__inner">
    <div class="header__left">
      <a href="/" class="header__logo">{{ site.name }}</a>
