          {% endif %}
        </a>
        {% endfor %}
      </div>
      <span class="header__city">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
        {{ site.address }}
      </span>
    </div>

    <nav class="header__nav">
      <!-- Услуги -->
      <div class="nav-item nav-item--dropdown" data-dropdown="services">
        <button class="nav-item__btn">Услуги <span class="nav-item__icon">+</span></button>
        <div class="dropdown dropdown--services">
          <div class="dropdown__inner">
            <ul class="dropdown__services-list">
              {% for service in nav.services %}
              <li class="dropdown__service-item" data-service="{{ loop.index0 }}">
                <span class="dropdown__service-name">{{ service.name }}</span>
                <span class="dropdown__arrow">→</span>
              </li>
              {% endfor %}
            </ul>
            <div class="dropdown__subservices">
              {% for service in nav.services %}
              <ul class="dropdown__sub-list" data-sub="{{ loop.index0 }}">
                {% for sub in service.subservices %}
                <li><a href="/{{ sub.slug }}">{{ sub.name }}</a></li>
                {% endfor %}
              </ul>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>

      <!-- О компании -->
      <div class="nav-item nav-item--dropdown" data-dropdown="company">
        <button class="nav-item__btn">О компании <span class="nav-item__icon">+</span></button>
        <div class="dropdown dropdown--company">
          <ul class="dropdown__list">
            {% for item in nav.company %}
            <li><a href="/{{ item.slug }}">{{ item.name }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </nav>

    <div class="header__right">
      <a href="{{ site.phoneHref }}" class="header__phone">{{ site.phone }}</a>
      <button class="header__cta" id="openModal">Связаться с нами →</button>
    </div>

    <button class="burger" id="burger" aria-label="Меню">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
{% endif %}

<!-- MOBILE NAV -->
<div class="mobile-nav" id="mobileNav">
  <div class="mobile-nav__overlay" id="mobileNavOverlay"></div>
  <nav class="mobile-nav__drawer">
    <div class="mobile-nav__head">
      <a href="/" class="mobile-nav__logo">{{ site.name }}</a>
      <button class="mobile-nav__close" id="mobileNavClose">×</button>
    </div>
    <div class="mobile-nav__body">
      <div class="mobile-nav__section">
        <div class="mobile-nav__group-title">Услуги</div>
        {% for service in nav.services %}
        <a href="/{{ service.slug }}" class="mobile-nav__link">{{ service.name }}</a>
        {% endfor %}
      </div>
      <div class="mobile-nav__section">
        <div class="mobile-nav__group-title">О компании</div>
        {% for item in nav.company %}
        <a href="/{{ item.slug }}" class="mobile-nav__link">{{ item.name }}</a>
        {% endfor %}
      </div>
    </div>
    <div class="mobile-nav__footer">
      <a href="{{ site.phoneHref }}" class="mobile-nav__phone">{{ site.phone }}</a>
      <button class="mobile-nav__cta js-open-modal">Связаться с нами →</button>
    </div>
  </nav>
</div>

<!-- MAIN -->
<main>
  {{ content | safe }}
</main>

{% if not noFooter %}
<!-- FOOTER -->
<footer class="footer">
  <div class="footer__inner">
    <div class="footer__col footer__col--brand">
      <a href="/" class="footer__logo">{{ site.name }}</a>
      <p>{{ site.tagline }}</p>
