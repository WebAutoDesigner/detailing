---
layout: base.njk
title: Контакты
description: Контакты детейлинг студии — адрес, телефон, время работы, как добраться и форма обратной связи.
permalink: /kontakty/
noFooter: true
bodyClass: page-contacts
---

<!-- CONTACTS PAGE -->
<div class="contacts-page">

  <!-- SECTION 1: fullscreen map + floating card -->
  <section class="contacts-map-section">

    <!-- Map fills 100% -->
    {% if site.yandexMapsEmbed %}
    <div class="contacts-map-full">
      <iframe
        src="{{ site.yandexMapsEmbed }}"
        width="100%"
        height="100%"
        frameborder="0"
        title="Карта проезда"
      ></iframe>
      <!-- Blocks all map interaction -->
      <div class="contacts-map-blocker"></div>
    </div>
    {% endif %}

    <!-- Floating info card (top-right) -->
    <div class="contacts-card">

      <div class="contacts-card__header">
        <h1 class="contacts-card__title"><span class="contacts-card__slash">// </span>Контакты</h1>
        <div class="contacts-card__icons">
          {% if site.vk %}
          <a href="{{ site.vk }}" class="contacts-card__icon" target="_blank" rel="noopener" aria-label="ВКонтакте">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M15.684 0H8.316C1.592 0 0 1.592 0 8.316v7.368C0 22.408 1.592 24 8.316 24h7.368C22.408 24 24 22.408 24 15.684V8.316C24 1.592 22.408 0 15.684 0zm3.692 17.123h-1.744c-.66 0-.864-.525-2.05-1.727-1.033-1.01-1.49-1.135-1.744-1.135-.356 0-.458.102-.458.593v1.575c0 .424-.135.678-1.253.678-1.846 0-3.896-1.118-5.335-3.202C4.624 10.857 4.03 8.57 4.03 8.096c0-.254.102-.491.593-.491h1.744c.44 0 .61.203.78.677.863 2.49 2.303 4.675 2.896 4.675.22 0 .322-.102.322-.66V9.721c-.068-1.186-.695-1.287-.695-1.71 0-.203.17-.407.44-.407h2.744c.373 0 .508.203.508.643v3.473c0 .372.17.508.271.508.22 0 .407-.136.813-.542 1.254-1.406 2.151-3.574 2.151-3.574.119-.254.322-.491.762-.491h1.744c.525 0 .643.27.525.643-.22 1.017-2.354 4.031-2.354 4.031-.186.305-.254.44 0 .78.186.254.796.779 1.203 1.253.745.847 1.32 1.558 1.473 2.05.17.49-.085.745-.576.745z"/></svg>
          </a>
          {% endif %}
          {% if site.telegram %}
          <a href="{{ site.telegram }}" class="contacts-card__icon" target="_blank" rel="noopener" aria-label="Telegram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12L7.17 13.67l-2.96-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.194 1.006.131.978.889z"/></svg>
          </a>
          {% endif %}
        </div>
      </div>

      <a href="{{ site.phoneHref }}" class="contacts-card__phone">{{ site.phone }}</a>
      {% if site.email %}<a href="mailto:{{ site.email }}" class="contacts-card__email">{{ site.email }}</a>{% endif %}

      <div class="contacts-card__row">
        <span class="contacts-card__label">Адрес:</span>
        <span class="contacts-card__value">{{ site.address }}</span>
      </div>

      <div class="contacts-card__row">
        <span class="contacts-card__label">Режим работы:</span>
        <span class="contacts-card__value">{{ site.workHours }}{% if site.workHoursShort %}<br>{{ site.workHoursShort }}{% endif %}</span>
      </div>

    </div>
  </section>

  <!-- SECTION 2: CTA form (full width, 100vh) -->
  <section class="cta-form contacts-cta">
    <div class="cta-form__bg" style="--cta-bg-desk: url('{{ pagedata.worksHeroBg }}'); --cta-bg-mob: url('{{ site.ctaBg }}')"></div>
    <div class="contacts-cta__inner">
      <h2>Записаться<br>на услугу</h2>
      <p>Оставьте заявку — перезвоним в течение 15 минут и подберём удобное время</p>
      <form class="cta-form__form" id="contacts-form" novalidate>
        <input type="text" name="name" placeholder="Ваше имя" required>
        <input type="tel" name="phone" placeholder="Телефон" required>
        <textarea name="message" placeholder="Комментарий (необязательно)" rows="3"></textarea>
        <label class="cta-form__checkbox">
          <input type="checkbox" name="agree" required>
          <span>Нажимая кнопку, вы соглашаетесь с политикой обработки персональных данных</span>
        </label>
        <button type="submit" class="btn btn--outline">Отправить заявку →</button>
      </form>
    </div>
  </section>

</div>
