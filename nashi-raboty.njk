---
layout: base.njk
title: Наши работы
description: Примеры работ детейлинг студии — фотографии выполненных проектов по оклейке плёнкой, полировке, керамическим покрытиям и химчистке.
permalink: /nashi-raboty/
---

<!-- PAGE HERO -->
<section class="page-hero page-hero--full" style="--hero-bg: url('{% if pagedata.worksHero %}{{ pagedata.worksHero.bg }}{% else %}{{ site.ctaBg }}{% endif %}'); --hero-bg-mobile: url('{% if pagedata.worksHero %}{% if pagedata.worksHero.bgMobile %}{{ pagedata.worksHero.bgMobile }}{% else %}{{ pagedata.worksHero.bg }}{% endif %}{% else %}{{ site.ctaBg }}{% endif %}')">
  <div class="page-hero__overlay"></div>
  <div class="page-hero__content">
    <nav class="breadcrumb" aria-label="Хлебные крошки">
      <a href="/">Главная</a>
      <span>—</span>
      <span>Наши работы</span>
    </nav>
    <h1>{% if pagedata.worksHero and pagedata.worksHero.title %}{{ pagedata.worksHero.title }}{% else %}Наши работы{% endif %}</h1>
    <p>{% if pagedata.worksHero and pagedata.worksHero.subtitle %}{{ pagedata.worksHero.subtitle }}{% else %}Примеры выполненных проектов — оклейка, полировка, керамика, химчистка{% endif %}</p>
  </div>
</section>

<!-- WORKS GALLERY -->
<section class="works-page">
  <div class="works-page__header">
    <h2 class="section-title">Галерея работ</h2>
    <p>Каждая работа — результат внимательного подхода и профессионального мастерства</p>
  </div>
  <div class="works-page__grid">
    {% for img in pagedata.works %}
    <div class="works-page__item">
      <img
        src="{{ img }}"
        alt="Работа детейлинг студии {{ loop.index }}"
        loading="{% if loop.index <= 4 %}eager{% else %}lazy{% endif %}"
      >
    </div>
    {% endfor %}
  </div>
</section>

<!-- CTA -->
<section class="cta-form contacts-cta">
  <div class="cta-form__bg" style="--cta-bg-desk: url('{{ pagedata.worksHeroBg }}'); --cta-bg-mob: url('{{ site.ctaBg }}')"></div>
  <div class="contacts-cta__inner">
    <h2>Хотите такой же результат?</h2>
    <p>Оставьте заявку — мы свяжемся, обсудим задачу и подберём оптимальный пакет услуг для вашего автомобиля.</p>
    <form class="cta-form__form" id="cta-form-works" novalidate>
      <input type="text" name="name" placeholder="Ваше имя" required>
      <input type="tel" name="phone" placeholder="Телефон" required>
      <label class="cta-form__checkbox">
        <input type="checkbox" name="agree" required>
        <span>Нажимая кнопку, вы соглашаетесь с политикой обработки персональных данных</span>
      </label>
      <button type="submit" class="btn btn--outline">Оставить заявку →</button>
    </form>
  </div>
</section>
